# LLM Provider Configuration (mock, openrouter, openai)
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=30

# Embeddings & Vector Store
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_STORE_PATH=./data/index

# Retrieval Configuration
RETRIEVAL_MODE=hybrid
TOP_K=5
SCORE_THRESHOLD=0.35
MAX_CONTEXT_CHARS=8000

# Chunking Configuration
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=60

# OCR Configuration
OCR_MIN_TEXT_CHARS=30
OCR_LOW_CONF_WORD=30
OCR_LOW_CONF_CHUNK=60
TESSERACT_CMD=
OCR_EXTRACT_EMBEDDED_IMAGES=true
OCR_MIN_IMAGE_DIM=100
OCR_DPI=300
OCR_FORCE_PDF_OCR=false

# API & Security
MAX_QUERY_CHARS=1000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO

